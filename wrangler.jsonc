{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grani-miniapp2",
  "main": "bot/src/index.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "grani-analytics",
      "database_id": "6ed30b11-13d8-415e-baad-6b2b139fab94"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APPLICATIONS",
        "class_name": "ApplicationsStore"
      }
    ]
  },
  "exports": {
    "ApplicationsStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "MINI_APP_URL": "https://4000680.github.io/grani_miniapp2/",
    "CONTACT_URL": "https://t.me/grani_broker",
    "DONATE_URL": "",
    "GEOCODER_URL": "https://nominatim.openstreetmap.org/search"
  }
}
